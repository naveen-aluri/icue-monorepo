  "version": "0.2.0",
  "configurations": [
    {
      "name": "SUPER ADMIN DEV",
      "cwd": "apps/super_admin",
      "request": "launch",
      "type": "dart",
      "args": ["--flavor", "dev"],
      "toolArgs": ["--dart-define", "ENVIRONMENT=DEV"]
    },
    {
      "name": "ADMIN DEV",
      "cwd": "apps/icueadmin",
      "request": "launch",
      "type": "dart",
      "args": ["--flavor", "dev"],
      "toolArgs": ["--dart-define", "ENVIRONMENT=DEV"]
    },
    {
      "name": "ADMIN PROD",
      "cwd": "apps/icueadmin",
      "request": "launch",
      "type": "dart",
      "args": ["--flavor", "prod"],
      // "flutterMode": "release",
      "toolArgs": ["--dart-define", "ENVIRONMENT=PROD"]
    },
    {
      "name": "ADMIN WEB",
      "type": "dart",
      "cwd": "apps/icueadmin",
      "request": "launch",
      "args": ["-d", "chrome"],
      // "args": ["-d", "web-server"],
      "toolArgs": ["--dart-define", "ENVIRONMENT=DEV"]
    },
    {
      "name": "face sdk example",
      "cwd": "packages/icue_face_sdk/example",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "face sdk example (profile mode)",
      "cwd": "packages/icue_face_sdk/example",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "face sdk example (release mode)",
      "cwd": "packages/icue_face_sdk/example",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}
